API_BASE = "http://zhaoyuehui02-tbpwk-sl-mcp.open.cater.sjst.test.sankuai.com/v1/api/voyage/openapi/query"
TOKEN_URL = "https://developer.sjst.st.sankuai.com/zh/v2/dev/token"

# Token 存储路径（固定在 skill 目录下）
TOKEN_FILE = os.path.expanduser("~/.openclaw/skills/travel-assistant/token.json")


# =====================
# Token 管理
# =====================

def load_token() -> str | None:
    """从本地文件加载 Token，不存在则返回 None"""
    if not os.path.exists(TOKEN_FILE):
        return None
    try:
        with open(TOKEN_FILE, "r") as f:
            data = json.load(f)
            return data.get("token", "").strip() or None
    except (json.JSONDecodeError, IOError):
        return None


def save_token(token: str) -> None:
    """保存 Token 到本地文件"""
    with open(TOKEN_FILE, "w") as f:
        json.dump({"token": token.strip()}, f)


def clear_token() -> None:
    """清除本地存储的 Token"""
    if os.path.exists(TOKEN_FILE):
        os.remove(TOKEN_FILE)


