# =====================
# 查询类型识别
# =====================

ITINERARY_KEYWORDS = ["行程", "攻略", "几日游", "几天", "旅游路线", "安排"]
ATTRACTION_KEYWORDS = ["景点", "必去", "推荐景点", "好去处", "观光"]
HOTEL_KEYWORDS = ["酒店", "民宿", "住宿", "旅馆"]
FOOD_KEYWORDS = ["美食", "餐厅", "必吃", "小吃", "推荐吃的", "特色菜"]
TICKET_KEYWORDS = ["门票", "票价", "多少钱"]


def classify_query(query_text: str) -> str:
    if any(kw in query_text for kw in ITINERARY_KEYWORDS):
        return "itinerary"
    if any(kw in query_text for kw in FOOD_KEYWORDS):
        return "food"
    if any(kw in query_text for kw in HOTEL_KEYWORDS):
        return "hotel"
    if any(kw in query_text for kw in ATTRACTION_KEYWORDS):
        return "attraction"
    if any(kw in query_text for kw in TICKET_KEYWORDS):
        return "ticket"
    return "general"


# =====================
# 链接处理
# =====================

def wrap_link(name: str, raw_url: str) -> str:
    if not raw_url:
        return name
    url = raw_url.strip()
    if url.startswith("imeituan://"):
        encoded = urllib.parse.quote(url, safe="")
        return f"[{name}](https://trip-button-action.mynocode.host/#/?redirect={encoded})"
    if "dianping.com" in url and "url=" in url:
        try:
            parsed = urllib.parse.urlparse(url)
            params = urllib.parse.parse_qs(parsed.query)
            if "url" in params:
                imeituan = urllib.parse.unquote(params["url"][0])
                encoded = urllib.parse.quote(imeituan, safe="")
                return f"[{name}](https://trip-button-action.mynocode.host/#/?redirect={encoded})"
        except Exception:
            pass
    return name


def process_links_in_text(text: str) -> str:
    def replace_link(match):
        name = match.group(1).strip()
        url = match.group(2).strip()
        return wrap_link(name, url)
    return re.sub(r'\[([^\]]+)\]\((https?://[^\)]+)\)', replace_link, text)


# =====================
# 格式化输出
# =====================

def format_itinerary(content: str, city: str) -> str:
    lines = content.split("\n")
    output = []
    in_day = False
    prev_empty = True
    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            output.append("")
            continue
        if re.match(r"^📝\s*DAY", stripped, re.IGNORECASE) or re.match(r"^DAY", stripped, re.IGNORECASE):
            if not prev_empty:
                output.append("")
            output.append(f"\n{stripped}")
            prev_empty = False
            in_day = True
            continue
        if (stripped.startswith("·") or stripped.startswith("-") or stripped.startswith("*")) and in_day:
            output.append(f"  {stripped}")
            prev_empty = False
            continue
        if re.match(r"^[\u4e00-\u9fa5]{2,10}(\s|$)", stripped) and len(stripped) < 50 and not prev_empty:
            output.append(f"  {stripped}")
            prev_empty = False
            continue
        if prev_empty and len(stripped) > 5:
            output.append(f"\n{stripped}")
        else:
            output.append(stripped)
        prev_empty = False
    return process_links_in_text("\n".join(output)).strip()


def format_attraction(content: str) -> str:
    lines = content.split("\n")
    output = []
    prev_empty = True
    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            continue
        link_match = re.match(r"\[([^\]]+)\]\((https?://[^\)]+)\)", stripped)
        if link_match:
            name = link_match.group(1).strip()
            url = link_match.group(2).strip()
            output.append(f"  {wrap_link(name, url)}")
            prev_empty = False
            continue
        if "⭐" in stripped or "评分" in stripped:
            output.append(f"  {stripped}")
            prev_empty = False
            continue
        if len(stripped) > 10 and prev_empty:
            output.append(f"\n{stripped}")
            prev_empty = False
            continue
        if "小贴士" in stripped or "贴士" in stripped:
            output.append(f"\n{stripped}")
            prev_empty = True
            continue
        output.append(f"  {stripped}")
        prev_empty = False
    return process_links_in_text("\n".join(output)).strip()


def format_hotel(content: str) -> str:
    lines = content.split("\n")
    output = []
    prev_empty = True
    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            continue
        if stripped.startswith("方案") or stripped.startswith("推荐") or stripped.startswith("酒店"):
            output.append(f"\n{stripped}")
            prev_empty = False
            continue
        link_match = re.match(r"\[([^\]]+)\]\((https?://[^\)]+)\)", stripped)
        if link_match:
            name = link_match.group(1).strip()
            url = link_match.group(2).strip()
            output.append(f"  {wrap_link(name, url)}")
            prev_empty = False
            continue
        if "评分" in stripped or "价格" in stripped or "起" in stripped or "星级" in stripped or "距离" in stripped:
            output.append(f"  {stripped}")
            prev_empty = False
            continue
        if "小贴士" in stripped or "---" in stripped:
            output.append(f"\n{stripped}")
            prev_empty = True
            continue
        if len(stripped) > 5:
            output.append(f"  {stripped}")
        prev_empty = False
    return process_links_in_text("\n".join(output)).strip()


def format_food(content: str) -> str:
    lines = content.split("\n")
    output = []
    prev_empty = True
    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            continue
        link_match = re.match(r"\[([^\]]+)\]\((https?://[^\)]+)\)", stripped)
        if link_match:
            name = link_match.group(1).strip()
            url = link_match.group(2).strip()
            output.append(f"  {wrap_link(name, url)}")
            prev_empty = False
            continue
        if "小贴士" in stripped or "---" in stripped:
            output.append(f"\n{stripped}")
            prev_empty = True
            continue
        if len(stripped) > 5:
            output.append(f"  {stripped}")
        prev_empty = False
    return process_links_in_text("\n".join(output)).strip()


def format_general(content: str) -> str:
    return process_links_in_text(content).strip()


def format_output(content: str, query_text: str) -> str:
    qtype = classify_query(query_text)
    if qtype == "itinerary":
        return format_itinerary(content, "")
    elif qtype == "hotel":
        return format_hotel(content)
    elif qtype == "food":
        return format_food(content)
    elif qtype == "attraction":
        return format_attraction(content)
    else:
        return format_general(content)


# =====================
# API 查询
# =====================

def query(city: str, city_id: int, query_text: str, token: str) -> dict:
    payload = {
        "xtDebugCellName": "gray-release-hotel-ai-distill",
        "userId": 214900659,
        "city": city,
        "cityId": city_id,
        "query": query_text,
    }
    headers = {
        "Authorization": token,
        "Content-Type": "application/json",
    }
    req = urllib.request.Request(
        API_BASE,
        data=json.dumps(payload).encode(),
        headers=headers,
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        return {"code": -1, "msg": str(e)}


# =====================
# Token 子命令
# =====================

def cmd_token(argv: list):
    """处理 token 子命令"""
    if not argv:
        print("用法: travel token [set|show|clear]")
        return
    action = argv[0]
    if action == "set":
        if len(argv) < 2:
            print("❌ 请提供 Token 值: travel token set <token>")
            sys.exit(1)
        save_token(argv[1])
        print(f"✅ Token 已保存至 {TOKEN_FILE}")
    elif action == "show":
        token = load_token()
        if token:
            print(f"当前 Token: {token}")
        else:
            print("未设置 Token，请先注册: " + TOKEN_URL)
    elif action == "clear":
        clear_token()
        print("✅ Token 已清除")
    else:
        print(f"未知 token 操作: {action}")
        print("用法: travel token [set|show|clear]")


# =====================
# 主程序
# =====================

def main():
    # 手动解析第一个参数判断是否是 token 子命令
    if len(sys.argv) >= 2 and sys.argv[1] == "token":
        cmd_token(sys.argv[2:])
        return

    # 正常查询流程
    parser = argparse.ArgumentParser(
        prog="travel",
        description="旅行助手 CLI - 酒店、景点、行程、火车票查询",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  travel -c 北京 -q "天安门附近酒店"
  travel -c 上海 -q "外滩五星级酒店推荐"
  travel -c 昆明 -q "3日游行程规划"
  travel -c 北京 -q "北京到上海高铁"
  travel -c 北京 -q "故宫门票多少钱"
  travel -c 北京 -q "北京必去景点推荐"
  travel -c 石家庄 -q "石家庄亲子游推荐"
  travel -c 丽江 -q "丽江必吃美食餐厅推荐"
  travel --json -c 北京 -q "天安门附近酒店"

Token 管理:
  travel token set <your-token>  # 设置 Token
  travel token show              # 查看当前 Token
  travel token clear             # 清除 Token

首次使用请先注册 Token: https://developer.sjst.st.sankuai.com/zh/v2/dev/token
        """,
    )
    parser.add_argument("--city", "-c", required=True, help="目标城市")
    parser.add_argument("--city-id", type=int, default=None, help="城市 ID（可选）")
    parser.add_argument("--query", "-q", required=True, help="查询内容")
    parser.add_argument("--json", "-j", action="store_true", help="输出原始 JSON")

    args = parser.parse_args()

    # 检查 Token
    token = load_token()
    if not token:
        print("❌ 未设置 Token，请先注册并设置：", file=sys.stderr)
        print(f"   1. 访问 {TOKEN_URL} 注册获取 Token", file=sys.stderr)
        print(f"   2. 运行: travel token set <your-token>", file=sys.stderr)
        sys.exit(1)

    city_id = args.city_id or CITY_IDS.get(args.city)
    print(f"🔍 查询中: {args.city} - {args.query}", file=sys.stderr)

    result = query(args.city, city_id, args.query, token)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        if result.get("code") != 0:
            print(f"❌ 错误: {result.get('msg', '未知错误')}", file=sys.stderr)
            sys.exit(1)
        content = result.get("data", "")
        if not content:
            print("⚠️ 未返回数据", file=sys.stderr)
            sys.exit(1)
        print(format_output(content, args.query))


if __name__ == "__main__":
    main()
