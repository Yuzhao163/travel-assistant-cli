  travel --city 北京 --query "故宫门票多少钱"
  travel --city 北京 --query "北京必去景点推荐"
  travel --city 石家庄 --query "石家庄亲子游推荐"
  travel --city 丽江 --query "丽江必吃美食餐厅推荐"
  travel --json --city 北京 --query "天安门附近酒店"
        """,
    )
    parser.add_argument("--city", "-c", required=True, help="目标城市")
    parser.add_argument("--city-id", type=int, default=None, help="城市 ID（可选）")
    parser.add_argument("--query", "-q", required=True, help="查询内容")
    parser.add_argument(
        "--json", "-j", action="store_true", help="输出原始 JSON"
    )

    args = parser.parse_args()
    city_id = args.city_id or CITY_IDS.get(args.city)

    print(f"🔍 查询中: {args.city} - {args.query}", file=sys.stderr)

    result = query(args.city, city_id, args.query)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        if result.get("code") != 0:
            print(f"❌ 错误: {result.get('msg', '未知错误')}", file=sys.stderr)
            sys.exit(1)
        content = result.get("data", "")
        if not content:
            print("⚠️ 未返回数据", file=sys.stderr)
            sys.exit(1)
        formatted = format_output(content, args.query)
        print(formatted)


if __name__ == "__main__":
    main()
