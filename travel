def format_general(content: str) -> str:
    """通用格式化：处理链接 + 清理"""
    result = process_links_in_text(content)
    return result.strip()


def format_output(content: str, query_text: str) -> str:
    """根据 query 类型自动选择格式化器"""
    qtype = classify_query(query_text)

    if qtype == "itinerary":
        return format_itinerary(content, "")
    elif qtype == "hotel":
        return format_hotel(content)
    elif qtype == "food":
        return format_food(content)
    elif qtype == "attraction":
        return format_attraction(content)
    else:
        return format_general(content)


def query(city: str, city_id: int, query_text: str) -> dict:
    payload = {
        "xtDebugCellName": "gray-release-hotel-ptest",
        "userId": 214900659,
        "city": city,
        "cityId": city_id,
        "query": query_text,
    }
    headers = {
        "Authorization": AUTH_TOKEN,
        "Content-Type": "application/json",
    }
    req = urllib.request.Request(
        API_BASE,
        data=json.dumps(payload).encode(),
        headers=headers,
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        return {"code": -1, "msg": str(e)}


