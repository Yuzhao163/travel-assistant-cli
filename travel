# 查询类型识别关键词
ITINERARY_KEYWORDS = ["行程", "攻略", "几日游", "几天", "旅游路线", "安排"]
ATTRACTION_KEYWORDS = ["景点", "必去", "推荐景点", "好去处", "观光"]
HOTEL_KEYWORDS = ["酒店", "民宿", "住宿", "旅馆"]
FOOD_KEYWORDS = ["美食", "餐厅", "必吃", "小吃", "推荐吃的", "特色菜"]
TICKET_KEYWORDS = ["门票", "票价", "多少钱"]


def classify_query(query_text: str) -> str:
    """根据 query 文本识别查询类型"""
    for kw in ITINERARY_KEYWORDS:
        if kw in query_text:
            return "itinerary"
    for kw in FOOD_KEYWORDS:
        if kw in query_text:
            return "food"
    for kw in HOTEL_KEYWORDS:
        if kw in query_text:
            return "hotel"
    for kw in ATTRACTION_KEYWORDS:
        if kw in query_text:
            return "attraction"
    for kw in TICKET_KEYWORDS:
        if kw in query_text:
            return "ticket"
    return "general"


def wrap_link(name: str, raw_url: str) -> str:
    """将美团/大众点评链接包装为跳转链接"""
    if not raw_url:
        return name
    url = raw_url.strip()
    if url.startswith("imeituan://"):
        encoded = urllib.parse.quote(url, safe="")
        return f"[{name}](https://trip-button-action.mynocode.host/#/?redirect={encoded})"
    if "dianping.com" in url and "url=" in url:
        try:
            parsed = urllib.parse.urlparse(url)
            params = urllib.parse.parse_qs(parsed.query)
            if "url" in params:
                imeituan = urllib.parse.unquote(params["url"][0])
                encoded = urllib.parse.quote(imeituan, safe="")
                return f"[{name}](https://trip-button-action.mynocode.host/#/?redirect={encoded})"
        except Exception:
            pass
    return name


def process_links_in_text(text: str) -> str:
    """处理文本中所有美团/点评链接，替换为 Markdown 链接格式"""
    # 匹配 [名称](url) 格式
    def replace_link(match):
        name = match.group(1).strip()
        url = match.group(2).strip()
        return wrap_link(name, url)

    # 处理 Markdown 链接格式 [text](url)
    text = re.sub(r'\[([^\]]+)\]\((https?://[^\)]+)\)', replace_link, text)
    return text


def format_itinerary(content: str, city: str) -> str:
    """格式化行程规划输出"""
    lines = content.split("\n")
    output = []
    in_day = False
    prev_empty = True

    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            output.append("")
            continue

        # 标题行（如 "📝 DAY1：..." 或 "📝 Day 1"）
        if re.match(r"^📝\s*DAY", stripped, re.IGNORECASE) or \
           re.match(r"^DAY", stripped, re.IGNORECASE):
            if not prev_empty:
                output.append("")
            output.append(f"\n{stripped}")
            prev_empty = False
            in_day = True
            continue

        # 景点/活动行（以 · 或 - 开头）
        if (stripped.startswith("·") or stripped.startswith("-") or \
            stripped.startswith("*")) and in_day:
            output.append(f"  {stripped}")
            prev_empty = False
            continue

        # 景点名称 + 描述（独立成行的景点行）
        if re.match(r"^[\u4e00-\u9fa5]{2,10}(\s|$)", stripped) and \
           len(stripped) < 50 and not prev_empty:
            output.append(f"  {stripped}")
            prev_empty = False
            continue

        # 普通段落
        if prev_empty and len(stripped) > 5:
            output.append(f"\n{stripped}")
        else:
            output.append(stripped)
        prev_empty = False

    result = "\n".join(output)
    result = process_links_in_text(result)
    return result.strip()


def format_attraction(content: str) -> str:
    """格式化景点推荐输出"""
    lines = content.split("\n")
    output = []
    prev_empty = True

    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            continue

        # 链接行：[景点名](url)
        link_match = re.match(r"\[([^\]]+)\]\((https?://[^\)]+)\)", stripped)
        if link_match:
            name = link_match.group(1).strip()
            url = link_match.group(2).strip()
            wrapped = wrap_link(name, url)
            output.append(f"  {wrapped}")
            prev_empty = False
            continue

        # 评分行（包含 ⭐ 或 评分）
        if "⭐" in stripped or "评分" in stripped:
            output.append(f"  {stripped}")
            prev_empty = False
            continue

        # 简介行
        if len(stripped) > 10 and prev_empty:
            output.append(f"\n{stripped}")
            prev_empty = False
            continue

        # 小贴士
        if "小贴士" in stripped or "贴士" in stripped:
            output.append(f"\n{stripped}")
            prev_empty = True
            continue

        output.append(f"  {stripped}")
        prev_empty = False

    result = "\n".join(output)
    result = process_links_in_text(result)
    return result.strip()


def format_hotel(content: str) -> str:
    """格式化酒店推荐输出"""
    lines = content.split("\n")
    output = []
    prev_empty = True

    for line in lines:
        stripped = line.strip()
        if not stripped:
            prev_empty = True
            continue

        # 方案/推荐行
        if stripped.startswith("方案") or stripped.startswith("推荐") or \
           stripped.startswith("酒店"):
            output.append(f"\n{stripped}")
            prev_empty = False
            continue

        # 链接行
        link_match = re.match(r"\[([^\]]+)\]\((https?://[^\)]+)\)", stripped)
        if link_match:
            name = link_match.group(1).strip()
            url = link_match.group(2).strip()
            wrapped = wrap_link(name, url)
            output.append(f"  {wrapped}")
            prev_empty = False
            continue

        # 详情行
        if "评分" in stripped or "价格" in stripped or "起" in stripped or \
           "星级" in stripped or "距离" in stripped:
            output.append(f"  {stripped}")
            prev_empty = False
            continue

        # 分割线/小贴士
        if "小贴士" in stripped or "---" in stripped:
            output.append(f"\n{stripped}")
            prev_empty = True
            continue

        if len(stripped) > 5:
            output.append(f"  {stripped}")
        prev_empty = False

    result = "\n".join(output)
    result = process_links_in_text(result)
    return result.strip()


